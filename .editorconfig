# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 2
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

# Same settings as rustfmt.toml
[*.rs]
indent_size = 4
max_line_length = 120

[*.sh]
indent_size = 4

[Makefile]
indent_style = tab

# Alfred writes info.plist with tabs
[*.plist]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
